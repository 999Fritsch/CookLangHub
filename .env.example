# Copy this file to .env before you share the installation.

# Key that signs session cookies. Make a new one with:
#   openssl rand -hex 32
COOKLANGHUB_SESSION_SECRET=

# Where a browser reaches CookLangHub. Forgejo returns a person to it after
# a sign-in. Change it behind a reverse proxy.
COOKLANGHUB_PUBLIC_URL=http://localhost:8080

# Set to false only for plain HTTP on a name that is not localhost.
COOKLANGHUB_COOKIE_SECURE=true

# Public address of Forgejo. Change both values behind a reverse proxy.
FORGEJO_DOMAIN=localhost
FORGEJO_ROOT_URL=http://localhost:3000/

# `json` for machine-readable logs, `pretty` for a terminal.
COOKLANGHUB_LOG_FORMAT=json
